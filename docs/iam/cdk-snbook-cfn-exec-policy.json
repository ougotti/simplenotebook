{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NotesBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::simplenotebook-*",
        "arn:aws:s3:::simplenotebook-*/*"
      ]
    },
    {
      "Sid": "ReadLambdaCodeAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::cdk-snbook-assets-__ACCOUNT_ID__-ap-northeast-1/*"
    },
    {
      "Sid": "LambdaFunctions",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:ap-northeast-1:__ACCOUNT_ID__:function:SimplenotebookStack*"
    },
    {
      "Sid": "StackRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::__ACCOUNT_ID__:role/SimplenotebookStack*",
        "arn:aws:iam::__ACCOUNT_ID__:role/GitHubActionsCdkDeployRole"
      ]
    },
    {
      "Sid": "AttachLoggingManagedPoliciesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::__ACCOUNT_ID__:role/SimplenotebookStack*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
            "arn:aws:iam::aws:policy/service-role/AmazonAPIGatewayPushToCloudWatchLogs"
          ]
        }
      }
    },
    {
      "Sid": "ApiGateway",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": "arn:aws:apigateway:ap-northeast-1::*"
    },
    {
      "Sid": "AuthTable",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-1:__ACCOUNT_ID__:table/simplenotebook-*",
        "arn:aws:dynamodb:ap-northeast-1:__ACCOUNT_ID__:table/simplenotebook-*/index/*"
      ]
    },
    {
      "Sid": "Cognito",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:*",
        "cognito-identity:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "ResolveGoogleOAuthSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:ap-northeast-1:__ACCOUNT_ID__:secret:google/oauth-*"
    },
    {
      "Sid": "ReadCdkBootstrapVersion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-1:__ACCOUNT_ID__:parameter/cdk-bootstrap/snbook/*",
        "arn:aws:ssm:ap-northeast-1:__ACCOUNT_ID__:parameter/cdk-bootstrap/hnb659fds/version"
      ]
    }
  ]
}
