{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeCdkBootstrapRoles",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Resource": [
        "arn:aws:iam::__ACCOUNT_ID__:role/cdk-hnb659fds-deploy-role-__ACCOUNT_ID__-ap-northeast-1",
        "arn:aws:iam::__ACCOUNT_ID__:role/cdk-hnb659fds-file-publishing-role-__ACCOUNT_ID__-ap-northeast-1",
        "arn:aws:iam::__ACCOUNT_ID__:role/cdk-hnb659fds-lookup-role-__ACCOUNT_ID__-ap-northeast-1"
      ]
    },
    {
      "Sid": "ReadCdkBootstrapVersion",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-northeast-1:__ACCOUNT_ID__:parameter/cdk-bootstrap/hnb659fds/version"
    }
  ]
}
